      },
      {
        "command": "sessionDeck.toggleActivityTreeActive",
        "title": "Hide Activity Tree",
        "icon": "$(list-flat)",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.toggleDensity",
