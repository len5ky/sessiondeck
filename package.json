      },
      {
        "command": "sessionDeck.openCodex",
        "title": "Focus Codex Session",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.openProject",
        "title": "Open Project in New Window",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.pinProject",
        "title": "Pin Project",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.unpinProject",
        "title": "Unpin Project",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.hideSession",
        "title": "Hide Session",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.showHidden",
        "title": "Show Hidden Sessions",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.dismissOrphans",
        "title": "Dismiss all orphaned runs",
