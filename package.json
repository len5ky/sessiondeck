          "when": "false"
        },
        {
          "command": "sessionDeck.unpinProject",
          "when": "false"
        },
        {
          "command": "sessionDeck.hideSession",
          "when": "false"
        },
        {
          "command": "sessionDeck.setFilterFilled",
          "when": "false"
        },
        {
          "command": "sessionDeck.toggleActivityTreeActive",
