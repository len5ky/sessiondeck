{
  "name": "sessiondeck",
  "displayName": "SessionDeck",
  "description": "One panel for every Claude Code, Codex and Cursor session on this host: grouped by project, live status, subagent activity, unread and approval alerts, click-to-navigate.",
  "version": "0.41.1",
  "icon": "media/icon.png",
  "publisher": "len5ky",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/len5ky/sessiondeck"
  },
  "bugs": {
    "url": "https://github.com/len5ky/sessiondeck/issues"
  },
  "homepage": "https://github.com/len5ky/sessiondeck#readme",
  "keywords": [
    "claude-code",
    "claude",
    "session-monitor",
    "sessions",
    "agents",
    "codex",
    "cursor",
    "sessiondeck",
    "coding-agent",
    "ai"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionDeck",
          "title": "SessionDeck",
          "icon": "$(compass)"
        }
      ]
    },
    "views": {
      "sessionDeck": [
        {
          "id": "sessionDeck.sessions",
          "name": "Sessions",
          "icon": "$(compass)",
          "when": "!sessionDeck.columns"
        },
        {
          "id": "sessionDeck.table",
          "name": "Sessions",
          "type": "webview",
          "when": "sessionDeck.columns"
        },
        {
          "id": "sessionDeck.controlPanel",
          "name": "Control Panel",
          "icon": "$(settings-gear)",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionDeck.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "SessionDeck"
      },
      {
        "command": "sessionDeck.doctor",
