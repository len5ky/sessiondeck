        {
          "command": "sessionDeck.sessionProperties",
          "when": "view == sessionDeck.sessions && (viewItem =~ /^session/ || viewItem == cursor || viewItem == composerSession || viewItem == codex)"
        },
        {
          "command": "sessionDeck.showRemoteLastMessage",
          "when": "view == sessionDeck.sessions && viewItem == remoteSession"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionDeck.openSession",
          "when": "false"
        },
        {
          "command": "sessionDeck.showLastMessage",
          "when": "false"
        },
        {
          "command": "sessionDeck.sessionProperties",
          "when": "false"
        },
        {
